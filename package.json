{
  "name": "mobile-development-environment",
  "private": true,
  "description": "A design-token studio that lives inside an Expo app and writes its edits back to the codebase",
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "test:analytics": "node browser/analytics-tab.mjs",
    "test:board": "node browser/studio-board.mjs",
    "test:capture": "node browser/capture-mode.mjs",
    "test:present": "node browser/present-mode.mjs",
    "test:share": "node browser/share-link.mjs",
    "vr": "TZ=UTC node --experimental-strip-types vr/run.mjs compare",
    "vr:update": "TZ=UTC node --experimental-strip-types vr/run.mjs update",
    "vr:proof": "TZ=UTC node --experimental-strip-types vr/proof.mjs",
    "vr:docker": "bash scripts/vr-docker.sh",
    "guard": "bash scripts/guard.sh",
    "tokens": "node token-server/index.mjs",
    "export:web": "bash scripts/export-web.sh",
    "preview": "node scripts/serve-static.mjs",
    "web": "cd mobile && npx expo start --web",
    "ios": "cd mobile && npx expo start --ios"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "devDependencies": {
    "playwright": "1.58.0"
  }
}
