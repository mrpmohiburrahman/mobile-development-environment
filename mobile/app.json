{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBFAF7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Spline Sans",
                "fontDefinitions": [
                  {
                    "path": "./public/fonts/spline-sans/SplineSans_400Regular.ttf",
                    "weight": 400,
                    "style": "normal"
                  },
                  {
                    "path": "./public/fonts/spline-sans/SplineSans_600SemiBold.ttf",
                    "weight": 600,
                    "style": "normal"
                  },
                  {
                    "path": "./public/fonts/spline-sans/SplineSans_700Bold.ttf",
                    "weight": 700,
                    "style": "normal"
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./public/fonts/spline-sans/SplineSans_400Regular.ttf",
              "./public/fonts/spline-sans/SplineSans_600SemiBold.ttf",
              "./public/fonts/spline-sans/SplineSans_700Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
